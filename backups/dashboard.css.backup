  }
  
  .summary-card .card-content {
    text-align: center;
  }
  
  .navbar-brand {
    font-size: 1rem;
  }
  
  .navbar-brand i {
    font-size: 1.2rem;
  }
  
  .page-header {
    flex-direction: column;
    align-items: flex-start !important;
  }
  
  .action-buttons {
    width: 100%;
    margin-top: 1rem;
    justify-content: center;
  }
  
  .btn-toolbar {
    width: 100%;
    justify-content: flex-end;
  }
  
  .chart-wrapper, .table-container, .form-container {
    padding: 1rem;
  }
  
