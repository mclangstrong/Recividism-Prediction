/* Professional Dashboard Custom Styles - Fixed Column Sizing and Responsive Design */

:root {
  /* Official BJMP Color Scheme */
  --snuff-grey: #DDDADD;           /* Primary light background */
  --golden-yellow: #FFDF00;        /* Accent/Highlight color */
  --ultramarine: #10069F;          /* Primary dark blue */
  --crimson-red: #E4002B;          /* Danger/Alerts */
  
  /* Secondary colors */
  --kelly-green: #449600;          /* Success/Positive */
  --butter-cup: #D49924;           /* Warning/Attention */
  --waikawa-grey: #646f85;         /* Text and borders */
  --titan-white: #d1cfd3;          /* Light backgrounds */
  --black: #000000;                /* Text */
  --white: #ffffff;                /* Backgrounds and text */
  
  /* Semantic color mappings */
  --primary-color: var(--ultramarine);     /* Ultramarine as primary */
  --secondary-color: var(--golden-yellow); /* Golden yellow as secondary */
  --success-color: var(--kelly-green);     /* Green for success */
  --danger-color: var(--crimson-red);      /* Red for danger */
  --warning-color: var(--butter-cup);      /* Yellow for warnings */
  --info-color: var(--ultramarine);        /* Blue for info */
  --light-color: var(--titan-white);
  --dark-color: var(--waikawa-grey);
  --accent-color: var(--golden-yellow);
  
  /* Grayscale colors with better contrast */
  --gray-50: #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2937;
  --gray-900: #111827;
  
  /* UI variables */
  --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  --card-hover-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
  --sidebar-width: 260px;
  --header-height: 70px;
  --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  --border-radius: 16px;
  --border-radius-sm: 12px;
  --border-radius-lg: 20px;
  --font-family: 'Inter', 'Roboto', 'Poppins', 'Open Sans', sans-serif;
  --border: 1px solid var(--gray-200);
  --border-light: 1px solid var(--gray-100);
  --transition-fast: all 0.2s ease;
  --transition-slow: all 0.4s ease;
  
  /* Enhanced color variables for professional visualization */
  --risk-high: var(--crimson-red);
  --risk-medium: var(--butter-cup);
  --risk-low: var(--kelly-green);
  --risk-high-light: #f8d7da;
  --risk-medium-light: #fff3cd;
  --risk-low-light: #d1e7dd;
  --risk-high-dark: #842029;
  --risk-medium-dark: #856404;
  --risk-low-dark: #0f5132;
}

body {
  font-size: .875rem;
  background-color: var(--gray-50);
  font-family: var(--font-family);
  color: var(--gray-700);
  overflow-x: hidden;
  line-height: 1.6;
}

/* Main Layout - Fixed column sizing */
.container-fluid {
  padding-left: 0;
  padding-right: 0;
  max-width: 100%;
}

.row {
  margin-left: 0;
  margin-right: 0;
}

/* Professional Header */
.navbar {
  background: linear-gradient(135deg, var(--primary-color), #1a1a7a);
  box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
  height: var(--header-height);
  z-index: 1000;
  padding: 0 1.5rem;
  backdrop-filter: blur(10px);
}

.navbar-brand {
  font-weight: 700;
  font-size: 1.25rem;
  color: white !important;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.navbar-brand i {
  font-size: 1.5rem;
  animation: pulse 2s infinite;
}

/* Professional Sidebar */
.sidebar {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding-top: var(--header-height);
  width: var(--sidebar-width);
  background: linear-gradient(160deg, var(--primary-color), #0a045f, #08034a);
  box-shadow: 5px 0 25px rgba(0, 0, 0, 0.2);
  transition: var(--transition);
  color: white;
  overflow-y: auto;
  border-right: 1px solid rgba(25, 25, 255, 0.1);
}

.sidebar .nav-link {
  font-weight: 500;
  color: rgba(255, 255, 255, 0.8);
  padding: 0.875rem 1.5rem;
  border-radius: 0;
  margin: 0.125rem 1rem;
  transition: var(--transition);
  display: flex;
  align-items: center;
  gap: 0.75rem;
  position: relative;
  overflow: hidden;
}

.sidebar .nav-link::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 3px;
  background-color: transparent;
  transition: var(--transition);
}

.sidebar .nav-link:hover {
  color: white;
  background-color: rgba(255, 223, 0.15);
  transform: translateX(5px);
  border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
}

.sidebar .nav-link:hover::before {
  background-color: var(--secondary-color);
}

.sidebar .nav-link.active {
  color: white;
  background-color: rgba(255, 223, 0, 0.25);
  position: relative;
  border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
}

.sidebar .nav-link.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 4px;
  background-color: var(--secondary-color);
}

.sidebar .nav-link i {
  width: 20px;
  text-align: center;
}

.sidebar-sticky {
  padding-top: 1rem;
}

.sidebar-heading {
  font-size: .75rem;
  text-transform: uppercase;
  padding: 0.75rem 1.5rem 0.25rem;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 600;
  letter-spacing: 1px;
}

/* Main Content - Fixed column sizing */
main {
  margin-left: var(--sidebar-width);
  padding-top: var(--header-height);
  transition: var(--transition);
  min-height: calc(100vh - var(--header-height));
  width: calc(100% - var(--sidebar-width));
}

/* Professional Card Styles */
.card {
  border: none;
  border-radius: var(--border-radius);
  box-shadow: var(--card-shadow);
  transition: var(--transition);
  background-color: #ffffff;
  margin-bottom: 1.5rem;
  overflow: hidden;
  position: relative;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  opacity: 0;
  transition: var(--transition);
}

.card:hover::before {
  opacity: 1;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.card-header {
  background: linear-gradient(to right, var(--white), var(--gray-50));
  border-bottom: 1px solid var(--gray-100);
  font-weight: 600;
  padding: 1.25rem 1.5rem;
  border-top-left-radius: var(--border-radius);
  border-top-right-radius: var(--border-radius);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border: none;
}

.card-body {
  padding: 1.5rem;
}

.card-title {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--gray-80);
}

/* Enhanced Summary Cards with Professional Visualization */
.summary-card {
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  transition: var(--transition);
  border: none;
  margin-bottom: 1.5rem;
  overflow: hidden;
  height: 100%;
  position: relative;
  background: linear-gradient(145deg, #ffffff, #f8f9fa);
  border: 1px solid rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  padding: 1.5rem !important;
}

.summary-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  opacity: 0;
  transition: var(--transition);
}

.summary-card:hover::before {
  opacity: 1;
}

.summary-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--card-hover-shadow);
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.summary-card .card-body {
  padding: 0 !important;
  display: flex;
  align-items: center;
  width: 100%;
}

.summary-card .card-icon {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 1rem;
  transition: var(--transition);
  flex-shrink: 0;
}

.summary-card:hover .card-icon {
  transform: scale(1.1);
}

.summary-card .card-content {
  text-align: left;
  flex-grow: 1;
}

.summary-card .card-number {
  font-size: 2.2rem;
  font-weight: 700;
  margin-bottom: 0.25rem;
  color: var(--gray-80);
  line-height: 1;
  transition: var(--transition);
}

.summary-card:hover .card-number {
  color: var(--primary-color);
}

.summary-card .card-label {
  font-size: 0.9rem;
  opacity: 0.8;
  margin-bottom: 0;
  color: var(--gray-600);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  font-weight: 500;
}

/* Enhanced Risk-specific Summary Cards */
.summary-card.high-risk .card-icon {
  background: linear-gradient(135deg, var(--risk-high), #c82333);
  color: white;
}

.summary-card.medium-risk .card-icon {
  background: linear-gradient(135deg, var(--risk-medium), #e0a800);
  color: #212529;
}

.summary-card.low-risk .card-icon {
  background: linear-gradient(135deg, var(--risk-low), #1e7e34);
  color: white;
}

.summary-card .clickable-card {
  cursor: pointer;
  transition: var(--transition);
}

.summary-card .clickable-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.summary-card .clickable-card:active {
  transform: translateY(0);
}

/* Clickable Cards */
.clickable-card {
  cursor: pointer;
  transition: var(--transition);
}

.clickable-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.clickable-card:active {
  transform: translateY(0);
}

/* Professional Chart Containers */
.chart-wrapper {
  background: #ffffff;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  padding: 1.75rem;
  margin-bottom: 1.5rem;
  transition: var(--transition);
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(10px);
}

.chart-wrapper::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  opacity: 0;
  transition: var(--transition);
}

.chart-wrapper:hover::before {
  opacity: 1;
}

.chart-wrapper:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.chart-header {
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--gray-100);
}

.chart-title {
  font-weight: 600;
  color: var(--gray-80);
  margin-bottom: 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.1rem;
}

/* Enhanced Chart Container with Better Visualization */
.chart-container {
  position: relative;
  height: 320px;
  width: 100%;
}

/* Professional Table Styles */
.table-container {
  background: #ffffff;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  padding: 1.75rem;
  margin-bottom: 1.5rem;
  transition: var(--transition);
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0, 0.05);
  backdrop-filter: blur(10px);
}

.table-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  opacity: 0;
  transition: var(--transition);
}

.table-container:hover::before {
  opacity: 1;
}

.table-container:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.table-header {
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--gray-100);
}

.table-title {
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 1.1rem;
}

.table {
  box-shadow: none;
  border-radius: calc(var(--border-radius) - 2px);
  overflow: hidden;
}

.table thead {
  background: linear-gradient(to bottom, var(--gray-50), var(--white));
}

.table th {
  font-weight: 600;
  color: var(--gray-700);
  background-color: transparent;
  padding: 1.1rem 1.25rem;
  border: none;
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.5px;
  border-top: 1px solid var(--gray-100);
}

.table td {
  padding: 1.1rem 1.25rem;
  vertical-align: middle;
  border-top: 1px solid var(--gray-100);
}

.table-hover tbody tr:hover {
  background-color: var(--gray-50);
  transition: var(--transition);
}

/* Professional Form Styles */
.form-container {
  background: #ffffff;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--card-shadow);
  padding: 1.75rem;
  margin-bottom: 1.5rem;
  transition: var(--transition);
  overflow: hidden;
  border: 1px solid rgba(0, 0, 0.05);
  backdrop-filter: blur(10px);
}

.form-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  opacity: 0;
  transition: var(--transition);
}

.form-container:hover::before {
  opacity: 1;
}

.form-container:hover {
  transform: translateY(-5px);
  box-shadow: var(--card-hover-shadow);
}

.form-header {
  margin-bottom: 1.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--gray-100);
  background: linear-gradient(135deg, var(--primary-color), #1a1a7a);
  color: white;
  border-radius: var(--border-radius-sm) var(--border-radius-sm) 0 0;
}

.form-header h5, .form-header h6 {
  color: white !important;
}

.form-title {
  font-weight: 600;
  color: white;
  margin-bottom: 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.form-label {
  font-weight: 500;
  color: var(--gray-800);
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.form-control, .form-select {
  border-radius: 10px;
  padding: 0.875rem 1.1rem;
  border: 1px solid var(--gray-300);
  transition: var(--transition);
  background-color: var(--gray-50);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.03);
  font-size: 0.9rem;
}

.form-control:focus, .form-select:focus {
  border-color: var(--secondary-color);
  box-shadow: 0 0 0 0.25rem rgba(255, 223, 0, 0.25), inset 0 1px 2px rgba(0, 0, 0, 0.1);
  background-color: #ffffff;
  outline: none;
  transform: translateY(-2px);
}

.form-control:hover, .form-select:hover {
  border-color: var(--gray-400);
  background-color: var(--gray-100);
}

/* Enhanced Input Effects */
.form-control {
  position: relative;
}

.form-control::placeholder {
  color: var(--gray-500);
  opacity: 0.7;
}

/* Enhanced focus effect for textboxes */
.form-control:focus {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(255, 223, 0, 0.2), inset 0 1px 2px rgba(0, 0, 0, 0.1);
}

/* Enhanced select dropdowns */
.form-select {
  background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m1 6 7 7 7-7'/%3e%3c/svg%3e");
  background-size: 16px 12px;
  background-repeat: no-repeat;
  background-position: right 0.75rem center;
  padding-right: 3rem;
}

/* Input groups */
.input-group {
  border-radius: 10px;
  overflow: hidden;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
}

.input-group-text {
  background-color: var(--gray-100);
  border: 1px solid var(--gray-300);
  border-right: none;
}

/* Enhanced textarea styling */
textarea.form-control {
  min-height: 120px;
  resize: vertical;
}

/* Form validation states */
.form-control.is-valid {
  border-color: var(--success-color);
  box-shadow: 0 0 0 0.25rem rgba(40, 167, 69, 0.25);
}

.form-control.is-invalid {
  border-color: var(--danger-color);
  box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
}

/* Professional Button Styles */
.btn {
  border-radius: 10px;
  padding: 0.75rem 1.375rem;
  font-weight: 500;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  border: none;
  font-size: 0.95rem;
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: 0.5s;
}

.btn:hover::before {
  left: 100%;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.18);
}

.btn:active {
  transform: translateY(0);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary-color), #1a1a7a);
  border-color: var(--primary-color);
}

.btn-primary:hover {
  background: linear-gradient(135deg, #1a1a7a, #0d057d);
  border-color: #1a1a7a;
}

.btn-success {
  background: linear-gradient(135deg, var(--success-color), #219653);
  border-color: var(--success-color);
}

.btn-success:hover {
  background: linear-gradient(135deg, #219653, #1e7e34);
  border-color: #219653;
}

.btn-outline-primary {
  border-radius: 10px;
  padding: 0.625rem 1.125rem;
  color: var(--primary-color);
  border-color: var(--primary-color);
}

.btn-outline-primary:hover {
  background: linear-gradient(135deg, var(--primary-color), #1a1a7a);
  border-color: var(--primary-color);
  color: white;
}

.btn-group .btn {
  border-radius: 0;
}

.btn-group .btn:first-child {
  border-top-left-radius: 10px;
  border-bottom-left-radius: 10px;
}

.btn-group .btn:last-child {
  border-top-right-radius: 10px;
  border-bottom-right-radius: 10px;
}

/* Professional Progress Bars */
.progress {
  border-radius: 20px;
  height: 14px;
  background-color: var(--gray-20);
  overflow: hidden;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.1);
}

.progress-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  font-weight: 500;
  position: relative;
}

.progress-bar::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    45deg,
    rgba(25, 255, 255, 0.2) 25%,
    transparent 25%,
    transparent 50%,
    rgba(255, 255, 255, 0.2) 50%,
    rgba(255, 25, 255, 0.2) 75%,
    transparent 75%
  );
  background-size: 20px 20px;
  animation: progress-bar-stripes 1s linear infinite;
}

@keyframes progress-bar-stripes {
  0% { background-position: 0 0; }
  100% { background-position: 20px 0; }
}

.progress-stacked {
  height: 14px;
  border-radius: 20px;
  overflow: hidden;
}

.progress-stacked .progress {
  margin-right: 2px;
  border-radius: 0;
  height: 100%;
}

.progress-stacked .progress:last-child {
  margin-right: 0;
}

/* Professional Badge Styles */
.badge {
  border-radius: 25px;
  padding: 0.4rem 0.9rem;
  font-size: 0.8rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.badge.bg-high-risk {
  background-color: var(--risk-high);
  color: white;
}

.badge.bg-medium-risk {
  background-color: var(--risk-medium);
  color: #212529;
}

.badge.bg-low-risk {
  background-color: var(--risk-low);
  color: white;
}

/* Professional Risk Level Colors */
.bg-high-risk {
  background-color: var(--risk-high) !important;
  color: white;
}

.bg-medium-risk {
  background-color: var(--risk-medium) !important;
  color: #212529;
}

.bg-low-risk {
  background-color: var(--risk-low) !important;
  color: white;
}

.text-high-risk {
  color: var(--risk-high) !important;
}

.text-medium-risk {
  color: var(--risk-medium) !important;
}

.text-low-risk {
  color: var(--risk-low) !important;
}

/* Professional Responsive Design - Fixed column sizing for desktop */
@media (min-width: 1200px) {
  .container-fluid {
    padding-left: 0;
    padding-right: 0;
  }
  
  .row {
    margin-left: 0;
    margin-right: 0;
  }
  
  .col-xl-1, .col-xl-2, .col-xl-3, .col-xl-4, .col-xl-5, .col-xl-6, 
  .col-xl-7, .col-xl-8, .col-xl-9, .col-xl-10, .col-xl-11, .col-xl-12 {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
  
  main {
    margin-left: var(--sidebar-width);
    padding-top: var(--header-height);
    width: calc(100% - var(--sidebar-width));
  }
  
  .sidebar {
    width: var(--sidebar-width);
  }
}

@media (min-width: 992px) and (max-width: 1199px) {
  .container-fluid {
    padding-left: 0;
    padding-right: 0;
  }
  
  .row {
    margin-left: 0;
    margin-right: 0;
  }
  
  .col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, 
  .col-lg-7, .col-lg-8, .col-lg-9, .col-lg-10, .col-lg-11, .col-lg-12 {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
  
  main {
    margin-left: var(--sidebar-width);
    padding-top: var(--header-height);
    width: calc(100% - var(--sidebar-width));
  }
  
  .sidebar {
    width: var(--sidebar-width);
  }
}

@media (min-width: 768px) and (max-width: 991px) {
  .container-fluid {
    padding-left: 0;
    padding-right: 0;
  }
  
  .row {
    margin-left: 0;
    margin-right: 0;
  }
  
  .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-5, .col-md-6, 
  .col-md-7, .col-md-8, .col-md-9, .col-md-10, .col-md-11, .col-md-12 {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
  
  main {
    margin-left: var(--sidebar-width);
    padding-top: var(--header-height);
    width: calc(100% - var(--sidebar-width));
  }
  
  .sidebar {
    width: var(--sidebar-width);
  }
}

/* Mobile Responsive Design */
@media (max-width: 768px) {
  .sidebar {
    transform: translateX(-100%);
    transition: var(--transition);
    width: var(--sidebar-width);
    position: fixed;
    height: 100vh;
    z-index: 1000;
  }
  
  .sidebar.show {
    transform: translateX(0);
  }
  
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0.5);
    z-index: 999;
  }
  
  .sidebar-overlay.show {
    display: block;
  }
  
  main {
    margin-left: 0 !important;
    padding-top: calc(var(--header-height) + 1rem);
    width: 100%;
  }
  
  .container-fluid .row > * {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
  
  .summary-card .card-body {
    flex-direction: column;
    text-align: center;
  }
  
  .summary-card .card-icon {
    margin-right: 0;
    margin-bottom: 1rem;
  }
  
  .summary-card .card-content {
    text-align: center;
  }
  
  .navbar-brand span.d-none.d-sm-inline {
    display: none !important;
  }
  
  .nav-link span {
    display: inline !important;
  }
  
  .page-header {
    padding: 0.75rem !important;
  }
}

@media (max-width: 576px) {
  .sidebar {
    width: 250px; /* Ensure proper width on mobile */
  }
  
  main {
    margin-left: 0;
    padding-top: calc(var(--header-height) + 1rem);
  }
  
  .container-fluid .row > * {
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  
  .summary-card .card-body {
    flex-direction: column;
    text-align: center;
  }
  
  .summary-card .card-icon {
    margin-right: 0;
