{% extends "base.html" %}

{% block content %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h2 mb-0"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Dashboard</h1>
            <p class="text-muted mb-0">Recidivism Risk Assessment Dashboard</p>
        </div>
    </div>

    <!-- Summary Cards Row -->
    <div class="row mb-4 g-3">
        <div class="col-xl-3 col-md-6 col-12 mb-3">
            <div class="summary-card h-100 clickable-card shadow-sm" id="total-inmates-card">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="card-icon me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-color), #1a1a7a); color: white;">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                    <div class="card-content text-start ms-3">
                        <div class="card-number text-primary fw-bold" id="total-inmates">0</div>
                        <div class="card-label text-muted">Total Inmates</div>
                    </div>
                </div>
            </div>
        <div class="col-xl-3 col-md-6 col-12 mb-3">
            <div class="summary-card h-100 clickable-card high-risk shadow-sm" id="high-risk-card">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="card-icon me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--risk-high), #c82333); color: white;">
                        <i class="fas fa-exclamation-triangle fa-lg"></i>
                    </div>
                    <div class="card-content text-start ms-3">
                        <div class="card-number text-danger fw-bold" id="high-risk">0</div>
                        <div class="card-label text-muted">High Risk</div>
                    </div>
                </div>
            </div>
        <div class="col-xl-3 col-md-6 col-12 mb-3">
            <div class="summary-card h-100 clickable-card medium-risk shadow-sm" id="medium-risk-card">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="card-icon me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--risk-medium), #e0a800); color: #212529;">
                        <i class="fas fa-exclamation-circle fa-lg"></i>
                    </div>
                    <div class="card-content text-start ms-3">
                        <div class="card-number text-warning fw-bold" id="medium-risk">0</div>
                        <div class="card-label text-muted">Medium Risk</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 col-12 mb-3">
            <div class="summary-card h-100 clickable-card low-risk shadow-sm" id="low-risk-card">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="card-icon me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, var(--risk-low), #1e7e34); color: white;">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                    <div class="card-content text-start ms-3">
                        <div class="card-number text-success fw-bold" id="low-risk">0</div>
                        <div class="card-label text-muted">Low Risk</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- Charts Row -->
    <div class="row mb-4 g-3">
        <div class="col-xl-6 col-12 mb-4">
            <div class="chart-wrapper h-100">
                <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                    <h5 class="chart-title"><i class="fas fa-chart-pie me-2 text-primary"></i>Risk Distribution</h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                            <li><a class="dropdown-item" href="#">Last 90 Days</a></li>
                            <li><a class="dropdown-item" href="#">Year to Date</a></li>
                        </ul>
                    </div>
                </div>
                <!-- Improved layout with pie chart on left and text on right -->
                <div class="row g-3">
                    <div class="col-md-8 mb-3 mb-md-0">
                        <div class="chart-container" style="height: 300px;">
                            <canvas id="riskDistributionChart"></canvas>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="risk-distribution-info">
                            <h6 class="border-bottom pb-2 mb-3"><i class="fas fa-info-circle me-2 text-primary"></i>Risk Insights</h6>
                            <p class="mb-3 small">The risk distribution chart shows the proportion of inmates in each risk category based on predictive modeling.</p>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                                        <strong>High Risk</strong>
                                    </div>
                                    <span class="badge bg-danger rounded-pill" id="high-risk-count">0</span>
                                </li>
                                <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-exclamation-circle text-warning me-2"></i>
                                        <strong>Medium Risk</strong>
                                    </div>
                                    <span class="badge bg-warning rounded-pill" id="medium-risk-count">0</span>
                                </li>
                                <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fas fa-check-circle text-success me-2"></i>
                                        <strong>Low Risk</strong>
                                    </div>
                                    <span class="badge bg-success rounded-pill" id="low-risk-count">0</span>
                                </li>
                            </ul>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Overall Confidence</small>
                                    <small class="text-muted" id="overall-confidence">0%</small>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: 0%" id="confidence-progress"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-12 mb-4">
            <div class="chart-wrapper h-100">
                <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                    <h5 class="chart-title"><i class="fas fa-chart-bar me-2 text-primary"></i>Risk Level Comparison</h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Last 30 Days</a></li>
                            <li><a class="dropdown-item" href="#">Last 90 Days</a></li>
                            <li><a class="dropdown-item" href="#">Year to Date</a></li>
                        </ul>
                    </div>
                </div>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="riskComparisonChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Charts Row -->
    <div class="row mb-4 g-3">
        <div class="col-xl-6 col-12 mb-4">
            <div class="chart-wrapper h-100">
                <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                    <h5 class="chart-title"><i class="fas fa-chart-line me-2 text-primary"></i>Prediction Trend</h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Monthly</a></li>
                            <li><a class="dropdown-item" href="#">Weekly</a></li>
                            <li><a class="dropdown-item" href="#">Daily</a></li>
                        </ul>
                    </div>
                </div>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="predictionTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-12 mb-4">
            <div class="chart-wrapper h-100">
                <div class="chart-header d-flex justify-content-between align-items-center mb-3">
                    <h5 class="chart-title"><i class="fas fa-chart-bar me-2 text-primary"></i>Confidence Distribution</h5>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="fas fa-filter me-1"></i>Filter
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">High Confidence</a></li>
                            <li><a class="dropdown-item" href="#">Medium Confidence</a></li>
                            <li><a class="dropdown-item" href="#">Low Confidence</a></li>
                        </ul>
                    </div>
                </div>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="confidenceChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Prediction Table -->
    <div class="row mb-4 g-3">
        <div class="col-12">
            <div class="table-container">
                <div class="table-header d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <h5 class="table-title mb-2 mb-md-0"><i class="fas fa-table me-2 text-primary"></i>Inmate Predictions</h5>
                    <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
                        <button class="btn btn-sm btn-outline-primary" id="refresh-table">
                            <i class="fas fa-sync me-1"></i> Refresh
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-sort me-1"></i>Sort
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Risk Level</a></li>
                                <li><a class="dropdown-item" href="#">Prediction Date</a></li>
                                <li><a class="dropdown-item" href="#">Probability</a></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="fas fa-filter me-1"></i>Filter
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">All Risk Levels</a></li>
                                <li><a class="dropdown-item" href="#">High Risk</a></li>
                                <li><a class="dropdown-item" href="#">Medium Risk</a></li>
                                <li><a class="dropdown-item" href="#">Low Risk</a></li>
                            </ul>
                        </div>
                    </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="predictions-table">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Inmate ID</th>
                                <th>Risk Level</th>
                                <th>Probability</th>
                                <th>Prediction Date</th>
                                <th>Confidence</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Table rows will be populated by JavaScript -->
                            <tr>
                                <td class="text-muted">No data available</td>
                                <td class="text-muted">-</td>
                                <td class="text-muted">-</td>
                                <td class="text-muted">-</td>
                                <td class="text-muted">-</td>
                                <td class="text-muted">-</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Profile Section (Hidden by default) -->
    <div class="row mb-4 g-3" id="profile-section" style="display: none;">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0"><i class="fas fa-user-circle me-2"></i>Inmate Profile Details</h5>
                    <button type="button" class="btn-close btn-close-white" aria-label="Close" id="close-profile"></button>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2 mb-3"><i class="fas fa-user me-2 text-primary"></i>Personal Information</h6>
                            <ul class="list-group list-group-flush" id="personal-info">
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Inmate ID</div>
                                        <div class="text-muted">Inmate-001</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Age</div>
                                        <div class="text-muted">32</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Gender</div>
                                        <div class="text-muted">Male</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Civil Status</div>
                                        <div class="text-muted">Married</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Education Level</div>
                                        <div class="text-muted">High School</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Job History</div>
                                        <div class="text-muted">Retail</div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="border-bottom pb-2 mb-3"><i class="fas fa-exclamation-triangle me-2 text-primary"></i>Risk Factors</h6>
                            <ul class="list-group list-group-flush" id="risk-factors">
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Type of Current Offense</div>
                                        <div class="text-muted">Illegal Drugs</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Prior Convictions</div>
                                        <div class="text-muted">0</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Infractions Count</div>
                                        <div class="text-muted">0</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Jail Behavior Rating</div>
                                        <div class="text-muted">Good</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Length of Current Sentence (yrs)</div>
                                        <div class="text-muted">2.0</div>
                                    </div>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-start bg-light">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">Risk Level</div>
                                        <div class="text-muted"><span class="badge bg-success">Low Risk</span></div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="row mt-3 g-3">
                        <div class="col-12">
                            <h6 class="border-bottom pb-2 mb-3"><i class="fas fa-chart-bar me-2 text-primary"></i>Behavioral Analysis</h6>
                            <div class="progress-stacked mt-3" style="height: 25px;">
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: 15%" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100">Prior Convictions</div>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-warning" role="progressbar" style="width: 30%" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100">Jail Behavior</div>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-info" role="progressbar" style="width: 20%" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">Therapy Attendance</div>
                                </div>
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 35%" aria-valuenow="35" aria-valuemin="0" aria-valuemax="100">Support Systems</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Upload Panel -->
    <div class="row mb-4 g-3">
        <div class="col-12">
            <div class="form-container border-0 shadow-sm">
                <div class="form-header bg-primary text-white py-3 px-3 px-md-4 d-flex justify-content-between align-items-center">
                    <h5 class="form-title mb-0"><i class="fas fa-cloud-upload-alt me-2"></i>Data Upload</h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <form id="upload-form" class="needs-validation" novalidate>
                        <div class="mb-3 mb-md-4">
                            <label for="csv-file" class="form-label fw-bold">Upload New Inmate Data (CSV)</label>
                            <div class="input-group">
                                <input type="file" class="form-control" id="csv-file" accept=".csv" required>
                                <label class="input-group-text" for="csv-file"><i class="fas fa-file-csv"></i></label>
                            </div>
                            <div class="form-text mt-2">Upload a CSV file containing multiple inmate records for batch processing</div>
                            <div class="invalid-feedback">Please select a CSV file to upload.</div>
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary px-3 px-md-4 py-2">
                                <i class="fas fa-upload me-2"></i>Upload and Process
                            </button>
                            <button type="button" class="btn btn-outline-secondary px-3 px-md-4 py-2">Cancel</button>
                        </div>
                    </form>
                    <div class="mt-3" id="upload-status" style="display: none;">
                        <div class="progress mb-2" style="height: 8px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                        </div>
                        <p class="mt-2 mb-0" id="upload-message"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Buttons -->
    <div class="row g-3 mb-4">
        <div class="col-12 d-flex justify-content-end gap-2 flex-wrap">
            <button type="button" class="btn btn-primary px-3 px-md-4 py-2" id="export-pdf">
                <i class="fas fa-file-pdf me-2"></i>Export to PDF
            </button>
            <button type="button" class="btn btn-success px-3 px-md-4 py-2" id="export-csv">
                <i class="fas fa-file-csv me-2"></i>Export to CSV
            </button>
            <button type="button" class="btn btn-outline-primary px-3 px-md-4 py-2" id="print-report">
                <i class="fas fa-print me-2"></i>Print Report
            </button>
        </div>
    </div>
</div>
{% endblock %}
